# Mẫu cấu hình. Trên server, ./setup.sh sinh .env (mode 600) từ những gì bạn
# trả lời; file này chỉ để tra đủ các biến. Mọi biến đều tuỳ chọn.
# reader tự đọc .env ở gốc dự án; biến đặt sẵn trong môi trường thì thắng.

# --- Truy cập
READER_HOST=0.0.0.0             # 127.0.0.1 = chỉ máy này gọi được
READER_PORT=5678
READER_TOKEN=                   # RỖNG = ai mở được trang cũng dùng được

# --- Trình duyệt
READER_BROWSER_CHANNEL=         # rỗng = Chromium của Playwright; "chrome" = Chrome thật
# READER_HEADLESS=true          # mặc định: true khi máy không có màn hình
# READER_PROXY=http://user:pass@host:3128
# READER_PROXY_ROTATE=9proxy proxy -c VN -p 60000   # IP sau proxy chết thì chạy lệnh này lấy IP mới
# READER_PROFILES=.profiles
# READER_INBOX_URL=https://outlook.live.com/mail/0/

# --- Gửi mã về hộp thư (bật khi có đủ SMTP_HOST và MAIL_TO)
# READER_SMTP_HOST=smtp.gmail.com
# READER_SMTP_PORT=587          # 465 = TLS ngay từ đầu, 587 = STARTTLS
# READER_SMTP_USER=toi@gmail.com
# READER_SMTP_PASSWORD=         # Gmail: mật khẩu ứng dụng 16 ký tự
# READER_MAIL_FROM=             # rỗng = READER_SMTP_USER
# READER_MAIL_TO=toi@gmail.com

# --- Bắn mã về hệ thống của bạn
# READER_WEBHOOK=https://cho-cua-ban/hook
# READER_WEBHOOK_SECRET=        # đi kèm ở header X-Reader-Secret

# --- Nhịp chạy
# READER_POLL_SECONDS=5
# READER_REFRESH_SECONDS=120
# READER_TIMEOUT_SECONDS=180
# READER_LOGIN_TIMEOUT_SECONDS=90
# READER_LOG_LEVEL=INFO         # DEBUG = từng nhịp poll
